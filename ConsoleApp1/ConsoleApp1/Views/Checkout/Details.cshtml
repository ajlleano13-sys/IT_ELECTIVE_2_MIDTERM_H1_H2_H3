@model ConsoleApp1.Models.Transaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="mb-4">
    <h2 class="fw-bold text-primary"><i class="bi bi-receipt me-2"></i>Transaction Details</h2>
</div>


<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-6 mb-3 mb-md-0">
                <h6 class="text-muted text-uppercase mb-1 fs-7">Transaction ID</h6>
                <p class="fw-bold fs-5 text-dark mb-0">@Model.TransactionId</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h6 class="text-muted text-uppercase mb-1 fs-7">Date & Time</h6>
                <p class="fw-semibold text-secondary mb-0">@Model.Date.ToString("f")</p>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-muted text-uppercase mb-1 fs-7">Customer Name</h6>
                <p class="fw-bold text-dark mb-0">@Model.CustomerName</p>
            </div>
            @if (!string.IsNullOrEmpty(Model.CustomerEmail))
            {
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase mb-1 fs-7">Customer Email</h6>
                    <p class="fw-semibold text-dark mb-0">@Model.CustomerEmail</p>
                </div>
            }
        </div>
    </div>
</div>


<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0 text-dark">Purchased Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product Name</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end pe-4">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PurchasedItems)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@item.ProductName</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-center"><span class="badge bg-secondary px-3 py-2 rounded-pill">@item.Quantity</span></td>
                            <td class="text-end pe-4 fw-bold text-success">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white p-4 d-flex justify-content-between align-items-center">
        <span class="fs-5 text-muted">Grand Total:</span>
        <span class="fs-2 fw-bold text-success">@Model.TotalAmount.ToString("C")</span>
    </div>
</div>


<div class="d-flex gap-2">
    <a asp-controller="Checkout" asp-action="History" class="btn btn-secondary px-4 py-2 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to History
    </a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4 py-2 fw-semibold">
        <i class="bi bi-shop me-1"></i> Back to Store
    </a>
</div>