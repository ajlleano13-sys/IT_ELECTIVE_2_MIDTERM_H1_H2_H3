@model IEnumerable<ConsoleApp1.Models.Transaction>

<h2>Transaction History</h2>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Transaction ID</th>
            <th>Date</th>
            <th>Customer Name</th>
            <th>Grand Total</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TransactionId</td>
                <td>@item.Date.ToString("g")</td>
                <td>@item.CustomerName</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TransactionId" class="btn btn-sm btn-info">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>