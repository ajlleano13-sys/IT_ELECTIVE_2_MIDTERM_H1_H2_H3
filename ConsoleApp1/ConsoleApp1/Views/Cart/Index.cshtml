@model ConsoleApp1.Models.ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="mb-4">
    <h2 class="fw-bold text-primary"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm p-5 text-center">
        <div class="card-body">
            <i class="bi bi-cart-x text-muted display-1 mb-3"></i>
            <h3>Your cart is empty.</h3>
            <p class="text-muted mb-4">Looks like you haven't added any products to your cart yet.</p>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary btn-lg px-4 fw-semibold">
                <i class="bi bi-arrow-left me-2"></i> Continue Shopping
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Product</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center" style="width: 180px;">Quantity</th>
                            <th class="text-end">Line Total</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.ProductName</td>
                                <td class="text-end">₱@item.UnitPrice.ToString("N2")</td>
                                <td>
                                    <form asp-controller="Cart"
                                          asp-action="UpdateQuantity"
                                          method="post"
                                          class="d-flex justify-content-center gap-1">

                                        <input type="hidden"
                                               name="ProductId"
                                               value="@item.ProductId" />

                                        <input type="number"
                                               name="Quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               class="form-control form-control-sm text-center fw-bold"
                                               style="width: 75px;" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Update
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end fw-bold text-success">₱@item.LineTotal.ToString("N2")</td>
                                <td class="text-center pe-4">
                                    <form asp-controller="Cart"
                                          asp-action="Remove"
                                          method="post">

                                        <input type="hidden"
                                               name="ProductId"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger px-3">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white p-4 d-flex justify-content-between align-items-center">
            <span class="fs-4 text-muted">Grand Total:</span>
            <span class="fs-2 fw-bold text-success">₱@Model.GrandTotal.ToString("N2")</span>
        </div>
    </div>

    <!-- Isang malinis na Action Bar sa ibaba -->
    <div class="d-flex justify-content-between align-items-center">
        <a asp-controller="Home" 
           asp-action="Index" 
           class="btn btn-outline-secondary btn-lg px-4 fw-semibold">
            <i class="bi bi-arrow-left me-2"></i> Continue Shopping
        </a>
        
        <a asp-controller="Checkout" 
           asp-action="Index" 
           class="btn btn-success btn-lg px-4 fw-semibold shadow-sm">
            Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
}